<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  DELIBERATELY LEGACY. See ../../README.md.
  JBoss 4 specific binding. Ties the application to one vendor and one version.
-->
<!DOCTYPE jboss PUBLIC
        "-//JBoss//DTD JBOSS 4.0//EN"
        "http://www.jboss.org/j2ee/dtd/jboss_4_0.dtd">
<jboss>

    <enterprise-beans>
        <session>
            <ejb-name>PayrollSession</ejb-name>
            <jndi-name>ejb/PayrollSession</jndi-name>
            <resource-ref>
                <res-ref-name>jdbc/PayrollDS</res-ref-name>
                <!-- Datasource owned by the app server, not the application. -->
                <jndi-name>java:/PayrollDS</jndi-name>
            </resource-ref>
        </session>
    </enterprise-beans>

    <resource-managers/>

</jboss>
