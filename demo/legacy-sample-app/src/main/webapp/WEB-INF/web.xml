<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
  DELIBERATELY LEGACY. See ../../../../README.md in this fixture.

  A Servlet 2.3 DTD-era deployment descriptor: everything is declared here because
  annotation-driven configuration did not exist yet. Kept as-is on purpose.
-->
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>

    <display-name>Acme Legacy Order Service</display-name>

    <!-- Root context: XML bean definitions, loaded by a listener. -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>
            classpath:applicationContext.xml
            classpath:spring-security.xml
        </param-value>
    </context-param>

    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>

    <!--
      Spring Security 3.2 filter chain. Declared before the dispatcher so it wraps every
      request, including the SOAP endpoint.
    -->
    <filter>
        <filter-name>springSecurityFilterChain</filter-name>
        <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>springSecurityFilterChain</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Hand-rolled character encoding filter; Spring has shipped one since 2004. -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.acme.orders.web.LegacyEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>ISO-8859-1</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Spring 4 MVC, returning JSP views. -->
    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/dispatcher-servlet.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- JAX-WS SOAP endpoint. The whole reason this application still exists. -->
    <listener>
        <listener-class>com.sun.xml.ws.transport.http.servlet.WSServletContextListener</listener-class>
    </listener>
    <servlet>
        <servlet-name>orderSoapService</servlet-name>
        <servlet-class>com.sun.xml.ws.transport.http.servlet.WSServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>orderSoapService</servlet-name>
        <url-pattern>/services/OrderService</url-pattern>
    </servlet-mapping>

    <!--
      Sessions are held in memory and spilled to the local filesystem (see
      session.store.dir in application.properties), so this cannot be scaled
      horizontally without sticky sessions.
    -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <!-- Renders the stack trace to the browser. -->
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>

</web-app>
